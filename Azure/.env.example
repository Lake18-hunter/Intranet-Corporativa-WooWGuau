# Copia este archivo como .env y completa los valores.
# .env NUNCA se sube al repositorio (está en .gitignore).

AZ_RESOURCE_GROUP=gr-woowGuau-bd
AZ_LOCATION=mexicocentral

# Red privada
VNET_NAME=vnet-woowguau
VNET_PREFIX=10.20.0.0/16
SUBNET_MYSQL=snet-mysql
SUBNET_MYSQL_PREFIX=10.20.1.0/24
SUBNET_APP=snet-app
SUBNET_APP_PREFIX=10.20.2.0/24
NSG_MYSQL=nsg-snet-mysql
NSG_APP=nsg-snet-app

# Servidor MySQL
MYSQL_SERVER_NAME=srv-woowguau-mysql
MYSQL_ADMIN_USER=adminwoowguau
MYSQL_ADMIN_PASSWORD=
MYSQL_DATABASE=intranet_woowguau
MYSQL_VERSION=8.0.21
MYSQL_SKU=Standard_B1ms
MYSQL_TIER=Burstable
MYSQL_STORAGE_GB=20

# VM cliente (sin IP pública) desde donde Python envía comandos SQL
VM_NAME=vm-cliente-python
VM_SIZE=Standard_B2ats_v2
VM_ADMIN_USER=azureuser

# Respaldos (días, entre 1 y 35)
BACKUP_RETENTION_DAYS=7

# Presupuesto mensual (en la moneda de la suscripción) y correos de alerta
BUDGET_NAME=presupuesto-woowguau-bd
BUDGET_AMOUNT=20
BUDGET_EMAILS=aaragont2200@alumno.ipn.mx
